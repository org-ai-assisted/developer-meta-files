## The Debian-architecture -> qemu machine-name map.
##
## style-ok: no-strict -- sourced-only fragment.

dist_build_arch_to_qemu_machine() {
   case "${1}" in
      amd64)
         printf '%s' "x86_64"
         ;;
      arm64)
         printf '%s' "aarch64"
         ;;
      ## Both 32-bit ARM variants use the same emulator.
      armel)
         printf '%s' "arm"
         ;;
      armhf)
         printf '%s' "arm"
         ;;
      mipsel)
         printf '%s' "mipsel"
         ;;
      mips64el)
         printf '%s' "mips64el"
         ;;
      ## The emulator for ppc64el really is ppc64le. This is not a typo.
      ppc64el)
         printf '%s' "ppc64le"
         ;;
      riscv64)
         printf '%s' "riscv64"
         ;;
      s390x)
         printf '%s' "s390x"
         ;;
      *)
         return 1
         ;;
   esac
}
