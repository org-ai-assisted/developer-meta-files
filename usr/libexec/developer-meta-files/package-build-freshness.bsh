## AI-Assisted

# shellcheck shell=bash

## Named for what it does: decide whether a package needs a rebuild, from a
## manifest of source-content hashes. Accurate by construction -- a change to any
## source byte (including a debian/changelog version bump) moves the hash -- so it
## needs no query to the local reprepro repo. The reprepro published-version path
## was removed: it was a second, less reliable mechanism for the same decision
## (reprepro can report a version that no longer matches what is on disk).

## style-ok: no-strict -- sourced library; a strict-mode preamble would leak
## errexit/nounset into the caller's shell.

## Deterministic content hash of a package source tree: every non-VCS entry's path
## AND content. Detects an edit that did NOT bump debian/changelog, so local debug
## builds rebuild exactly the changed packages -- no package names, no changelog.
## Content alone is not enough. 'find -type f' does not match SYMLINKS at all, and sha256sum
## hashes bytes only, so retargeting a symlink or a chmod produced an IDENTICAL hash and the
## rebuild gate skipped a package that really had changed. Three streams are folded in:
##   * type + mode + relative path of EVERY entry, so a chmod, a new empty directory, or a
##     file replaced by a symlink all move the digest,
##   * symlink TARGETS, which no amount of content hashing can see,
##   * regular-file CONTENT in path order -- the path itself is already carried by the first
##     stream, so only the content digest is folded in (no filename, hence location-neutral).
## Paths are relative (find's %P), NUL-terminated and sorted under LC_ALL=C, so the result is
## deterministic and safe for odd filenames. No 'cd' -- the caller's working directory is
## never touched, and the hash does not depend on where the tree lives on disk.
dm_package_source_hash() {
   local package_source_dir="$1"
   if [ ! -d "${package_source_dir}" ]; then
      printf '%s\n' "nohash"
      return
   fi
   local git_dir="${package_source_dir}/.git"
   {
      find "${package_source_dir}" -path "${git_dir}" -prune -o -printf '%y %m %P\0' | LC_ALL=C sort -z
      find "${package_source_dir}" -path "${git_dir}" -prune -o -type l -printf '%P -> %l\0' | LC_ALL=C sort -z
      find "${package_source_dir}" -path "${git_dir}" -prune -o -type f -print0 \
         | LC_ALL=C sort -z \
         | xargs -0 -r sha256sum \
         | cut -d ' ' -f 1
   } | sha256sum | cut -d ' ' -f 1
}

## Per-codename source-hash manifest. Kept under binary_build_folder_dist, which
## is per-build-slot ('derivative-binary/<slot>'), co-located with that slot's
## local reprepro repo -- so it is NOT shared across build slots (a package
## published in one slot's repo must not read as up-to-date in another). Placed in
## a dedicated 'packages-build-status' subfolder rather than the build-folder root.
dm_source_hash_manifest_path() {
   printf '%s\n' "${binary_build_folder_dist}/packages-build-status/source-hashes.${1}.txt"
}

## Manifest lines are written by dm_source_hash_record below as '<source_pkg> <hash>', one
## space, never any other whitespace -- so splitting on the FIRST space is exact, and both
## helpers below compare the package with '=' rather than any pattern syntax. That exactness
## is the point: 'grep -v -- "^${source_pkg} "' read the name as a basic regular expression,
## where '.' matches any character, so recording a hash for 'foo.bar' silently dropped an
## unrelated 'fooXbar' entry.

## Look up the recorded source hash for a source package (empty if none).
dm_source_hash_lookup() {
   local manifest="$1" source_pkg="$2" line manifest_pkg manifest_hash
   [ -f "${manifest}" ] || return 0
   ## '|| [ -n "${line}" ]' so a final line with no trailing newline is still examined.
   while IFS= read -r line || [ -n "${line}" ]; do
      manifest_pkg="${line%% *}"
      if [ "${manifest_pkg}" = "${source_pkg}" ]; then
         ## The strict '<pkg> <hash>' format (see above) guarantees no trailing
         ## content, so the hash is exactly the remainder after the first space.
         printf '%s\n' "${line#* }"
         return 0
      fi
   done < "${manifest}"
   return 0
}

## Record/replace a source package's hash in the manifest (call after publishing).
dm_source_hash_record() {
   local manifest="$1" source_pkg="$2" hash="$3" tmp line manifest_pkg
   mkdir --parents -- "$(dirname -- "${manifest}")"
   tmp="$(mktemp)"
   if [ -f "${manifest}" ]; then
      while IFS= read -r line || [ -n "${line}" ]; do
         manifest_pkg="${line%% *}"
         if [ "${manifest_pkg}" = "${source_pkg}" ]; then
            continue
         fi
         ## Echo the line VERBATIM rather than reassembling it from fields, so an entry this
         ## function does not own is never reformatted.
         printf '%s\n' "${line}"
      done < "${manifest}" > "${tmp}"
   fi
   printf '%s\n' "${source_pkg} ${hash}" >> "${tmp}"
   mv -- "${tmp}" "${manifest}"
}

## Decide whether a package source tree needs (re)building.
##   dm_package_needs_rebuild <package_source_dir> <apt_codename>
## Return 0 (needs rebuild) when the source CONTENT differs from what was last
## built -- which includes a debian/changelog version bump, since the changelog
## is part of the hashed tree -- OR when nothing was ever recorded for it (no
## manifest entry, treated as changed, so a first build after adopting this
## repopulates the manifest safely). Return 1 (skip) only when the recorded hash
## matches the current source hash.
dm_package_needs_rebuild() {
   local package_source_dir apt_codename
   local source_pkg manifest current_hash stored_hash
   package_source_dir="$1"
   apt_codename="$2"

   source_pkg="$(dpkg-parsechangelog --show-field Source --file "${package_source_dir}/debian/changelog")"

   manifest="$(dm_source_hash_manifest_path "${apt_codename}")"
   current_hash="$(dm_package_source_hash "${package_source_dir}")"
   stored_hash="$(dm_source_hash_lookup "${manifest}" "${source_pkg}")"
   ## 'nohash' is dm_package_source_hash's failure sentinel, NOT a digest. It must
   ## never be compared like one: a source tree that fails to hash twice would
   ## otherwise read as 'unchanged' and be skipped. A hash failure forces a rebuild.
   if [ "${current_hash}" = "nohash" ] || [ -z "${stored_hash}" ] || [ "${stored_hash}" != "${current_hash}" ]; then
      true "INFO: rebuild ${source_pkg}: source content changed since last build (or first build, or hash failure)."
      return 0
   fi

   true "INFO: skip ${source_pkg}: source unchanged since last build."
   return 1
}
