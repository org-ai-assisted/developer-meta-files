## AI-Assisted

# shellcheck shell=bash

## Decides whether a package needs a rebuild, from a manifest of source-content
## hashes.

## style-ok: no-strict -- sourced library.

## Deterministic content hash of a package source tree. Detects an edit even
## if it did not bump debian/changelog.
dm_package_source_hash() {
   local package_source_dir="$1"
   ( cd -- "${package_source_dir}" 2>/dev/null || exit 1
     {
        ## Type, permission bits and path of every entry, sorted for
        ## determinism.
        find . -path './.git' -prune -o -printf '%y %m %p\0' | LC_ALL=C sort -z
        ## Symlink targets.
        find . -path './.git' -prune -o -type l -printf '%p -> %l\0' | LC_ALL=C sort -z
        ## Regular-file content.
        find . -path './.git' -prune -o -type f -print0 \
           | LC_ALL=C sort -z \
           | xargs -0 -r sha256sum
     } | sha256sum | cut -d ' ' -f 1
   ) || printf '%s\n' "nohash"
}

## Generate a per-codename source-hash manifest. Not shared across build slots.
dm_source_hash_manifest_path() {
   printf '%s\n' "${binary_build_folder_dist}/packages-build-status/source-hashes.${1}.txt"
}

## Manifest lines are written by dm_source_hash_record below as '<source_pkg> <hash>', one
## space, never any other whitespace.

## Look up the recorded source hash for a source package (empty if none).
dm_source_hash_lookup() {
   local manifest="$1" source_pkg="$2" line manifest_pkg
   [ -f "${manifest}" ] || return 0
   ## '|| [ -n "${line}" ]' so a final line with no trailing newline is still examined.
   while IFS= read -r line || [ -n "${line}" ]; do
      manifest_pkg="${line%% *}"
      if [ "${manifest_pkg}" = "${source_pkg}" ]; then
         printf '%s\n' "${line#* }"
         return 0
      fi
   done < "${manifest}"
   return 0
}

## Record/replace a source package's hash in the manifest (call after publishing).
dm_source_hash_record() {
   local manifest="$1" source_pkg="$2" hash="$3" tmp line manifest_pkg
   mkdir --parents -- "$(dirname -- "${manifest}")"
   tmp="$(mktemp)"
   if [ -f "${manifest}" ]; then
      while IFS= read -r line || [ -n "${line}" ]; do
         manifest_pkg="${line%% *}"
         if [ "${manifest_pkg}" = "${source_pkg}" ]; then
            continue
         fi
         ## Echo the line VERBATIM rather than reassembling it from fields, so an entry this
         ## function does not own is never reformatted.
         printf '%s\n' "${line}"
      done < "${manifest}" > "${tmp}"
   fi
   printf '%s\n' "${source_pkg} ${hash}" >> "${tmp}"
   mv -- "${tmp}" "${manifest}"
}

## Determine if a binary stanza's 'Architecture:' field covers a build target.
## Evaluate each token with dpkg-architecture so every Debian architecture
## wildcard (any, linux-any, any-amd64, ...) is matched, not just the plain and
## linux-<arch> forms a hand-rolled case can enumerate. A missed wildcard would
## make dm_package_artifacts_present skip the reprepro check and read a missing
## .deb as present.
dm_architecture_covers_target() {
   local architecture_field="$1" target="$2" token
   # shellcheck disable=SC2086
   for token in ${architecture_field}; do
      if dpkg-architecture --host-arch "${target}" --is "${token}"; then
         return 0
      fi
   done
   return 1
}

## Determine if the local package pool contains every .deb this source would
## would build for the current version and build targets.
dm_package_artifacts_present() {
   local control_file package_version target_list bin_pkg_and_archs_str \
      package_name archs_str target_item got_reprepro_output reprepro_output \
      found_expected package_source_dir

   package_source_dir="${1:-}"
   control_file="${package_source_dir}/debian/control"
   [ -f "${control_file}" ] || return 1
   package_version="$(dpkg-parsechangelog --show-field Version --file "${package_source_dir}/debian/changelog")"
   target_list="${make_cross_build_platform_list:-${dist_build_target_arch:-$(dpkg --print-architecture)}}"
   found_expected='false'

   ## Example bin_pkg_and_archs_str:
   ##     helper-scripts$'\t'all
   while read -r bin_pkg_and_archs_str; do
      package_name="${bin_pkg_and_archs_str%%$'\t'*}"
      archs_str="${bin_pkg_and_archs_str#*$'\t'}"
      found_expected='true'
      got_reprepro_output='false'

      # shellcheck disable=SC2086
      for target_item in ${target_list}; do
         ## Ensure the architecture we're testing is one the package supports.
         if ! [ "${archs_str}" = 'all' ] \
            && ! dm_architecture_covers_target "${archs_str}" "${target_item}"; then
            continue
         fi

         ## Ask reprepro if it knows about the package, and if so, what
         ## versions and architectures for that package it knows about.
         if [ "${got_reprepro_output}" = 'false' ]; then
            if ! reprepro_output="$(reprepro "${dist_build_reprepro_folder_options[@]}" list local "${package_name}")"; then
               return 1
            fi
            got_reprepro_output='true'
         fi

         ## Ensure a line of reprepro's output contains the combination of
         ## package name, version, and architecture we're checking for.
         if ! [[ "${reprepro_output}" \
            =~ (^|$'\n')local\|[^|]+\|"${target_item}: ${package_name} ${package_version}"($|$'\n') ]]; then
            return 1
         fi
      done
   ## Normalize CRLF line endings to LF BEFORE grep-dctrl: a CRLF-edited
   ## debian/control has '\r\n' on every line, including the blank paragraph
   ## separator, whose lone '\r' grep-dctrl reads as a field with no colon -- it
   ## aborts and emits nothing, forcing a needless rebuild. Dropping the EOL '\r'
   ## also removes a stray CR on a field value ('Architecture: all\r') that would
   ## otherwise defeat the 'all' fast-path and the arch match above, silently
   ## skipping the reprepro check and reading a missing .deb as present. Only the
   ## end-of-line CR is removed ('s/\r$//', not every '\r'), so a CR embedded in or
   ## leading a value is left for grep-dctrl to reject, never silently reshaping a
   ## field or a package name.
   done < <(sed 's/\r$//' "${control_file}" \
      | grep-dctrl -F 'Package' --pattern='' -s Package,Architecture -n \
      | sed -z 's/\n\([^\n]\)/\t\1/g; s/\n\t/\n/g; s/\n$//')

   ## Force a rebuild if a source package seems to declare no binary packages.
   if [ "${found_expected}" = "false" ]; then
      true "WARNING: Source package at '${package_source_dir}' appears to contain no binary packages?"
      return 1
   fi
   return 0
}

## Decide whether a package source tree needs (re)building.
##   dm_package_needs_rebuild <package_source_dir> <apt_codename>
## Returns 0 (needs rebuild) when the source content differs from what was last
## built, when nothing was ever recorded for it, or when its built artifact is no
## longer present in the local package output. Returns 1 (skip) only when the
## recorded hash matches the current source hash AND that artifact is still there.
dm_package_needs_rebuild() {
   local package_source_dir apt_codename
   local source_pkg manifest current_hash stored_hash
   package_source_dir="$1"
   apt_codename="$2"

   source_pkg="$(dpkg-parsechangelog --show-field Source --file "${package_source_dir}/debian/changelog")"

   ## Check that the binary packages for a source package exist.
   if ! dm_package_artifacts_present "${package_source_dir}"; then
      true "INFO: rebuild ${source_pkg}: a built artifact is absent from the local package pool."
      return 0
   fi

   manifest="$(dm_source_hash_manifest_path "${apt_codename}")"
   current_hash="$(dm_package_source_hash "${package_source_dir}")"
   stored_hash="$(dm_source_hash_lookup "${manifest}" "${source_pkg}")"
   ## 'nohash' is dm_package_source_hash's failure sentinel, which forces a
   ## rebuild.
   if [ "${current_hash}" = "nohash" ] || [ -z "${stored_hash}" ] || [ "${stored_hash}" != "${current_hash}" ]; then
      true "INFO: rebuild ${source_pkg}: source content changed since last build (or first build, or hash failure)."
      return 0
   fi

   true "INFO: skip ${source_pkg}: source unchanged since last build and artifacts present."
   return 1
}
