## AI-Assisted

## style-ok: no-strict -- sourced function library.

## Single source of truth for the RELEASED-artifact naming per build target.

# shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/strings.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/strings.bsh

## Set $1 to the released-image filename extension for target $2.
dm_reproducible_target_ext() {
   check_variable_name "${1:-}" || return 1

   local -n ext_ref="$1"
   case "${2:-}" in
      iso)
         ext_ref="iso"
         ;;
      virtualbox)
         ext_ref="ova"
         ;;
      raw)
         ext_ref="raw.libvirt.xz"
         ;;
      qcow2)
         ext_ref="qcow2.libvirt.xz"
         ;;
      utm)
         ext_ref="utm.tar.gz"
         ;;
      *)
         return 1
         ;;
   esac
}

## Set $1 to the download-URL path segment (<url_part>) for target $2. Covers the
## targets published for download (utm is not, so it is absent here).
dm_reproducible_target_url_part() {
   check_variable_name "${1:-}" || return 1

   local -n url_part_ref="$1"
   case "${2:-}" in
      iso)
         url_part_ref="iso"
         ;;
      virtualbox)
         url_part_ref="ova"
         ;;
      ## raw is not a published download, but the case is kept for manual /
      ## future / debugging use.
      raw)
         url_part_ref="raw"
         ;;
      qcow2)
         url_part_ref="libvirt"
         ;;
      *)
         return 1
         ;;
   esac
}

## Inverse of dm_reproducible_target_url_part.
dm_reproducible_url_part_to_target() {
   check_variable_name "${1:-}" || return 1

   local -n target_ref="$1"
   case "${2:-}" in
      iso)
         target_ref="iso"
         ;;
      ova)
         target_ref="virtualbox"
         ;;
      raw)
         target_ref="raw"
         ;;
      libvirt)
         target_ref="qcow2"
         ;;
      *)
         return 1
         ;;
   esac
}
