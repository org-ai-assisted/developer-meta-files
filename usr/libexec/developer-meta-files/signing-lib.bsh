#!/bin/bash

## Copyright (C) 2012 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Sourceable release signing + verification helpers.
##
## Callers must set these environment vars (e.g. by sourcing
## help-steps/variables):
##   DEBEMAIL
##   signify_public_key
##   signify_private_key
##
## The signify functions should only be used on small files. The OpenPGP
## functions should be used on every file that is signed or being signed.

## style-ok: no-strict -- a sourced library.

sign_cmd_openpgp() {
   local base_name
   base_name="$(basename -- "$1")"
   test -f "$1"
   test -n "${DEBEMAIL:-}"
   safe-rm -f -- "$2"
   ## OpenPGP signatures do not authenticate filenames by default, therefore add
   ## the name of the file as a OpenPGP notation so at least users that look
   ## at OpenPGP notations have a chance to detect if file names have been
   ## tampered with.
   sq sign --signature-notation "file@name" "${base_name}" --signer-email "${DEBEMAIL}" --signature-file="$2" -- "$1"
   test -f "$2"
}

sign_cmd_signify() {
   ## To create a key for signify-openbsd, see:
   ## derivative-maker help-steps/signing-key-create
   ## https://forums.whonix.org/t/signify-openbsd/7842
   signify-openbsd -S -s "${signify_private_key}" -m "$1" -x "$2"
   ## Sanity test.
   test -f "$2"
}

verify_cmd_openpgp() {
   test -f "$1"
   test -f "$2"
   test -n "${DEBEMAIL:-}"
   sq verify --signer-email "${DEBEMAIL}" --signature-file="$2" -- "$1"
}

verify_cmd_signify() {
   signify-openbsd -V -p "${signify_public_key}" -m "$1" -x "$2"
}

sign_and_verify() {
   sign_cmd_openpgp "${1}" "${1}.asc" || return
   verify_cmd_openpgp "${1}" "${1}.asc" || return
   ## This function used to call signify also, so delete any stale signify
   ## signature.
   safe-rm -f -- "${1}.sig" || return
}

sign_and_verify_signify() {
   sign_and_verify "${1}" || return
   sign_cmd_signify "${1}" "${1}.sig" || return
   verify_cmd_signify "${1}" "${1}.sig" || return
}

verify_signature() {
   verify_cmd_openpgp "${1}" "${1}.asc" || return
}

verify_signature_signify() {
   verify_signature "${1}" || return
   verify_cmd_signify "${1}" "${1}.sig" || return
}
