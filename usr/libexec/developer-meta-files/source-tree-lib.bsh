## AI-Assisted

## style-ok: no-strict -- a sourced fragment.

## Resolve the derivative-maker source tree for a tool that may run either from
## inside the checkout or as the installed '/usr/bin' copy.
##
## Usage -- source this before any 'cd', see the capture below:
##   source .../source-tree-lib.bsh
##   derivative_maker_source_tree_resolve "${MYDIR}" || exit 1
##   ## sets: derivative_maker_source_code_dir

[ -n "${derivative_maker_invocation_pwd:-}" ] || derivative_maker_invocation_pwd="${PWD}"

## Selects one source.
derivative_maker_source_tree_resolve() {
   local caller_dir="$1"
   local derivative_maker_in_tree_candidate

   if [ ! "${caller_dir}" = "/usr/bin" ]; then
      ## Five levels up is the derivative-maker root only for the submodule
      ## layout '<dm>/packages/<team>/developer-meta-files/usr/bin'.
      derivative_maker_in_tree_candidate="$( cd -- "${caller_dir}" && cd -- "../../../../../" && pwd )"
      if [ -r "${derivative_maker_in_tree_candidate}/help-steps/pre" ]; then
         derivative_maker_source_code_dir="${derivative_maker_in_tree_candidate}"
         return 0
      fi
   fi

   if [ -n "${source_code_folder_dist:-}" ]; then
      derivative_maker_source_code_dir="${source_code_folder_dist}"
   elif [ -r "${derivative_maker_invocation_pwd}/help-steps/pre" ]; then
      derivative_maker_source_code_dir="${derivative_maker_invocation_pwd}"
   else
      derivative_maker_source_code_dir="${HOME}/derivative-maker"
   fi

   if [ -r "${derivative_maker_source_code_dir}/help-steps/pre" ]; then
      return 0
   fi

   printf '%s\n' \
      "${0##*/}: no derivative-maker source tree at '${derivative_maker_source_code_dir}'." \
      "  (looked for '${derivative_maker_source_code_dir}/help-steps/pre')" >&2
   if [ "${derivative_maker_source_code_dir}" = "${derivative_maker_in_tree_candidate:-}" ]; then
      ## Bound to the tree this copy lives in, so naming source_code_folder_dist
      ## would send the operator after a variable that path does not consult.
      printf '%s\n' \
         "  (derived from this script's own location: '${caller_dir}')" \
         "This is the in-tree copy, so it uses the tree it belongs to and nothing else." >&2
   else
      printf '%s\n' \
         "Set 'source_code_folder_dist' to the checkout, or run this from one." >&2
   fi
   return 1
}
