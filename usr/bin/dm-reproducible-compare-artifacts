#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Compare the disk/ISO image produced by two independent builds for
## reproducibility. Given two build-output directories (each the uploaded
## '$HOME/binary_mnt' tree of one build job), locate the release image (by the
## target's extension) in each and hand the pair to 'dm-reproducible-compare'.
## Kept as a lint-covered, locally runnable script (repo convention) so the
## reproducibility CI lane's YAML stays a thin caller.
##
## Usage:
##   dm-reproducible-compare-artifacts \
##      --target TARGET --dir-a DIR --dir-b DIR --output REPORT
##
##   --target TARGET   the build target whose image to compare; selects the
##                     image by EXTENSION. Required, because the ISO build leaves
##                     BOTH the intermediate '.raw' disk and the final '.iso' in
##                     the output tree, so the released image must be chosen by
##                     extension. Exactly one match is expected. Mapping:
##                       virtualbox -> .ova    iso   -> .iso    raw -> .raw
##                       qcow2      -> .qcow2  utm   -> .utm
##
## Exit codes (passed through from reproducible-compare / diffoscope):
##   0  the two images are identical (reproducible)
##   1  differences remain (NOT reproducible yet)
##   2  usage / environment error (e.g. no image found)

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

error() {
   printf '%s\n' "ERROR: $*" >&2
   exit 2
}

MYDIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )"

## Shared target->released-extension map (also used by dm-reproducible-fetch).
# shellcheck source=../libexec/developer-meta-files/reproducible-target-map.bsh
source "${MYDIR}/../libexec/developer-meta-files/reproducible-target-map.bsh"

target=""
dir_a=""
dir_b=""
output_file=""

while [ "$#" -gt 0 ]; do
   case "${1:-}" in
      --target)     [ "$#" -ge 2 ] || error "--target requires a value."; target="$2"; shift 2 ;;
      --dir-a)      [ "$#" -ge 2 ] || error "--dir-a requires a value."; dir_a="$2"; shift 2 ;;
      --dir-b)      [ "$#" -ge 2 ] || error "--dir-b requires a value."; dir_b="$2"; shift 2 ;;
      --output)     [ "$#" -ge 2 ] || error "--output requires a value."; output_file="$2"; shift 2 ;;
      *)            error "unknown argument: '$1'." ;;
   esac
done

[ -n "${target}" ]      || error "--target is required."
[ -n "${dir_a}" ]       || error "--dir-a is required."
[ -n "${dir_b}" ]       || error "--dir-b is required."
[ -n "${output_file}" ] || error "--output is required."
[ -d "${dir_a}" ]       || error "--dir-a is not a directory: '${dir_a}'"
[ -d "${dir_b}" ]       || error "--dir-b is not a directory: '${dir_b}'"

## Map the build target to the extension of the RELEASED image (from the shared
## map, so it matches what dm-reproducible-fetch downloads). raw and qcow2 are
## released compressed, so their extension is '.raw.libvirt.xz' /
## '.qcow2.libvirt.xz' -- picking '*.raw' / '*.qcow2' would compare the
## uncompressed build intermediate, not the artifact users download.
image_ext=""
dm_reproducible_target_ext image_ext "${target}" \
   || error "unsupported --target '${target}' (expected virtualbox|iso|raw|qcow2|utm)."

## Locate the release image for the requested target: the single file with the
## target's extension. 'nullglob' so a missing extension yields an empty array;
## 'globstar' to descend the version subfolder. The extension already excludes
## the build's intermediates (they carry other extensions, e.g. the ISO build's
## '.raw' beside its '.iso'), so exactly one match is expected -- zero or several
## is an error, not a silent size-based pick. Genuinely no subshell, no find, no
## stat: the result is returned through a nameref, not command substitution.
##
## $1 names the caller's output variable (a literal, trusted internal name, so
## no check_variable_name guard is needed); $2 is the dir, $3 the extension.
find_image() {
   local -n image_result
   local search_dir wanted_ext had_nullglob had_globstar
   local -a image_candidates=()

   image_result="$1"
   search_dir="$2"
   wanted_ext="$3"

   ## Enable the globs, remembering the caller's state so it can be restored
   ## without a '$( shopt -p )' subshell + eval.
   had_nullglob="false"
   had_globstar="false"
   shopt -q nullglob && had_nullglob="true"
   shopt -q globstar && had_globstar="true"
   shopt -s nullglob globstar
   image_candidates=( "${search_dir}"/**/*."${wanted_ext}" )
   [ "${had_nullglob}" = "true" ] || shopt -u nullglob
   [ "${had_globstar}" = "true" ] || shopt -u globstar

   if [ "${#image_candidates[@]}" -eq 0 ]; then
      error "no '.${wanted_ext}' image (target '${target}') found under '${search_dir}'."
   fi
   if [ "${#image_candidates[@]}" -gt 1 ]; then
      error "multiple '.${wanted_ext}' images (target '${target}') found under '${search_dir}'; ambiguous: ${image_candidates[*]}"
   fi

   image_result="${image_candidates[0]}"
}

image_a=""
image_b=""
find_image image_a "${dir_a}" "${image_ext}"
find_image image_b "${dir_b}" "${image_ext}"

printf '%s\n' "INFO: image A: ${image_a}" >&2
printf '%s\n' "INFO: image B: ${image_b}" >&2

## Pass through reproducible-compare's exit code unchanged so the CI lane's job
## conclusion IS the reproducibility pass/fail signal.
compare_exit="0"
"${MYDIR}/dm-reproducible-compare" \
   --output "${output_file}" \
   "${image_a}" \
   "${image_b}" \
   || compare_exit="$?"

exit "${compare_exit}"
