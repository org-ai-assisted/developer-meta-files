#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Verify a PUBLISHED image against a LOCAL rebuild -- image-level reproducible
## build verification (the analogue of a Debian package rebuilder, applied to the
## derivative's disk/ISO images).
##
## Needs no build flags: everything required to reproduce is read from the signed
## '<image>.dm-buildinfo' that the build published NEXT TO the image (see
## dm-reproducible-buildinfo). Given just the image URL this:
##   1. downloads the image UNTRUSTED (only ever read by diffoscope; never
##      executed / booted / rw-mounted),
##   2. downloads the sibling '.dm-buildinfo' + its signify signature, and the
##      '.sha512sums' + its signature, all from the SAME folder,
##   3. verifies both signatures with the release signify public key, and checks
##      the downloaded image against the signed sha512sum,
##   4. rebuilds the recorded target locally and diffoscope-compares.
##
## SOURCE_DATE_EPOCH derives from debian/changelog, so a rebuild from the
## recorded Source-Commit reproduces the image; run inside the standard build
## container so the build path is canonical (see the reproducibility docs).
##
## Usage:
##   dm-reproducible-verify IMAGE_URL [--signify-pubkey KEY] [--output REPORT] \
##      [--allowlist FILE] [--work DIR] [--keep] [--skip-build]
##
## Exit codes:
##   0  reproduced bit-for-bit (after the allowlist)
##   1  differences remain -- NOT reproducible (report written)
##   2  usage / download / signature / environment error

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

## style-ok: no-has
## Self-contained downstream verifier (runs outside a build tree), so it probes
## for signify / sq / scurl / git with 'command -v' rather than sourcing the
## 'has' helper from helper-scripts.

error() {
   printf '%s\n' "ERROR: $*" >&2
   exit 2
}

MYDIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )"
dm_share_dir="$( cd -- "${MYDIR}/../share/developer-meta-files" && pwd )"
## The derivative-maker source root: this submodule lives under
## <derivative-maker>/packages/kicksecure/developer-meta-files, so five levels up
## from usr/bin (same walk dm-prepare-release uses). Needed to run the rebuild
## and read the source git state.
dm_source_root="$( cd -- "${MYDIR}/../../../../.." 2>/dev/null && pwd || true )"

## Reuse dm-prepare-release's exact sign/verify code -- no hand-rolled sq/signify.
# shellcheck source=../libexec/developer-meta-files/signing-lib.bsh
source "${MYDIR}/../libexec/developer-meta-files/signing-lib.bsh"

url=""
## Verification trust anchors the lib's verify_cmd_* read; defaults match
## help-steps/variables. For a real release, provide the maintainer OpenPGP cert
## to sq and point --signify-pubkey at the maintainer signify public key.
signify_public_key="${signify_public_key:-${HOMEVAR:-${HOME}}/.signify/keyname.pub}"
DEBEMAIL="${DEBEMAIL:-derivative-distribution@local-signing.key}"
output_file=""
allowlist_file="${dm_share_dir}/reproducible-allowlist.conf"
work_dir=""
keep="false"
skip_build="false"

while [ "$#" -gt 0 ]; do
   case "${1:-}" in
      --signify-pubkey) [ "$#" -ge 2 ] || error "--signify-pubkey requires a value."; signify_public_key="$2"; shift 2 ;;
      --output)         [ "$#" -ge 2 ] || error "--output requires a value."; output_file="$2"; shift 2 ;;
      --allowlist)      [ "$#" -ge 2 ] || error "--allowlist requires a value."; allowlist_file="$2"; shift 2 ;;
      --work)           [ "$#" -ge 2 ] || error "--work requires a value."; work_dir="$2"; shift 2 ;;
      --keep)           keep="true"; shift ;;
      --skip-build)     skip_build="true"; shift ;;
      -h|--help)        grep '^##' -- "${BASH_SOURCE[0]}" | sed 's/^## \{0,1\}//'; exit 0 ;;
      -*)               error "unknown option: '$1' (run with --help)." ;;
      *)                [ -z "${url}" ] || error "unexpected extra argument: '$1'"; url="$1"; shift ;;
   esac
done

[ -n "${url}" ] || error "an image URL is required: reproducible-verify IMAGE_URL"

command -v signify-openbsd >/dev/null 2>&1 || error "signify-openbsd not found; cannot verify signatures."
command -v sq >/dev/null 2>&1 || error "sq (Sequoia OpenPGP) not found; cannot verify signatures."
command -v scurl >/dev/null 2>&1 || command -v curl >/dev/null 2>&1 || error "neither scurl nor curl found."

## Private scratch dir; the untrusted download is only ever read by diffoscope.
if [ -z "${work_dir}" ]; then
   work_dir="$(mktemp -d -- "${TMPDIR:-/tmp}/reproducible-verify.XXXXXX")"
fi
mkdir --parents -- "${work_dir}"
chmod 0700 -- "${work_dir}"
untrusted_dir="${work_dir}/untrusted"
mkdir --parents -- "${untrusted_dir}"

# shellcheck disable=SC2317  # body runs via the EXIT trap, not inline.
cleanup() {
   if [ "${keep}" = "true" ]; then
      printf '%s\n' "INFO: --keep set; leaving scratch dir '${work_dir}'." >&2
      return 0
   fi
   safe-rm --recursive --force -- "${work_dir}" 2>/dev/null || true
}
trap cleanup EXIT

## Downloader (resumable, https-only). scurl preferred (hardened wrapper).
fetch() {
   local src="$1" dst="$2"
   local dl=( curl --tlsv1.3 --proto '=https' --location --fail --retry 5 --retry-all-errors --retry-delay 10 )
   if command -v scurl >/dev/null 2>&1; then
      dl=( scurl --location --fail --retry 5 --retry-all-errors --retry-delay 10 )
   fi
   "${dl[@]}" --output "${dst}" -- "${src}" || error "download failed: ${src}"
}

## The buildinfo and every signature are siblings of the image in the same folder.
image_name="$(basename -- "${url%%\?*}")"
buildinfo_url="${url}.dm-buildinfo"
image_file="${untrusted_dir}/${image_name}"
buildinfo_file="${work_dir}/${image_name}.dm-buildinfo"
sha_file="${work_dir}/${image_name}.sha512sums"

printf '%s\n' "INFO: fetching image (UNTRUSTED) + buildinfo + signatures from the same folder..." >&2
fetch "${url}"                        "${image_file}"
fetch "${buildinfo_url}"              "${buildinfo_file}"
fetch "${buildinfo_url}.asc"          "${buildinfo_file}.asc"
fetch "${buildinfo_url}.sig"          "${buildinfo_file}.sig"
fetch "${url}.sha512sums"             "${sha_file}"
fetch "${url}.sha512sums.asc"         "${sha_file}.asc"
fetch "${url}.sha512sums.sig"         "${sha_file}.sig"

## Verify signatures BEFORE trusting any recorded parameter: an unverified
## buildinfo would let an attacker choose the rebuild inputs. Reuse the SAME
## verification as dm-prepare-release (OpenPGP '.asc' via sq + signify '.sig'),
## via the shared signing lib -- not a hand-rolled invocation.
[ -f "${signify_public_key}" ] || error "signify public key not found: '${signify_public_key}' (pass --signify-pubkey)."
printf '%s\n' "INFO: verifying buildinfo + sha512sums signatures (sq + signify)..." >&2
verify_and_check "${buildinfo_file}" \
   || error "buildinfo signature verification FAILED -- refusing to trust it."
verify_and_check "${sha_file}" \
   || error "sha512sums signature verification FAILED."

## The buildinfo carries no checksum by design; the signed sha512sums covers the
## image. Check the downloaded image against it (in its own dir, relative path).
printf '%s\n' "INFO: checking image against the signed sha512sums..." >&2
( cd -- "${untrusted_dir}" && sha512sum --check --strict -- "${sha_file}" ) \
   || error "image does not match the signed sha512sums -- download corrupt or tampered."

## Parse the now-trusted buildinfo (Deb822: 'Field: value').
bi_field() {
   local field="$1" line
   line="$(grep -m1 -E "^${field}:[[:space:]]" -- "${buildinfo_file}" || true)"
   printf '%s' "${line#*: }"
}
bi_flavor="$(bi_field Flavor)"
bi_target="$(bi_field Target)"
bi_type="$(bi_field Build-Type)"
bi_arch="$(bi_field Architecture)"
bi_freedom="$(bi_field Freedom)"
bi_commit="$(bi_field Source-Commit)"

[ -n "${bi_target}" ] || error "buildinfo has no Target field."
printf '%s\n' "INFO: verified buildinfo: flavor=${bi_flavor} target=${bi_target} type=${bi_type} arch=${bi_arch} freedom=${bi_freedom} commit=${bi_commit}" >&2

## Warn if the local source is not at the recorded commit -- a rebuild from a
## different tree will not reproduce.
if [ -n "${dm_source_root}" ] && command -v git >/dev/null 2>&1 && git -C "${dm_source_root}" rev-parse --git-dir >/dev/null 2>&1; then
   head_commit="$(git -C "${dm_source_root}" rev-parse HEAD 2>/dev/null || printf '%s' unknown)"
   case "${bi_commit}" in
      "${head_commit}"|unknown|'') : ;;
      *) printf '%s\n' "WARNING: local HEAD (${head_commit}) != buildinfo Source-Commit (${bi_commit}); check out the matching commit for a valid comparison." >&2 ;;
   esac
fi

## Rebuild the recorded target locally (reproduce inside the standard container
## for a canonical build path).
build_out="${binary_build_folder_dist:-${HOMEVAR:-${HOME}}/derivative-binary}"
if [ "${skip_build}" = "true" ]; then
   printf '%s\n' "INFO: --skip-build set; comparing against the existing build under '${build_out}'." >&2
else
   [ -n "${dm_source_root}" ] && [ -x "${dm_source_root}/derivative-maker" ] || error "derivative-maker source not found at '${dm_source_root}'; run from a derivative-maker source tree (or use --skip-build)."
   build_cmd=( "${dm_source_root}/derivative-maker" --flavor "${bi_flavor}" --target "${bi_target}" --arch "${bi_arch}" )
   [ -z "${bi_type}" ]    || [ "${bi_type}" = unknown ]    || build_cmd+=( --type "${bi_type}" )
   [ -z "${bi_freedom}" ] || [ "${bi_freedom}" = unknown ] || build_cmd+=( --freedom "${bi_freedom}" )
   printf '%s\n' "INFO: rebuilding locally: ${build_cmd[*]}" >&2
   "${build_cmd[@]}" || error "local rebuild failed."
fi

## Compare the untrusted download against the rebuild (diffoscope + allowlist).
compare_args=( --target "${bi_target}" --dir-a "${untrusted_dir}" --dir-b "${build_out}" --allowlist "${allowlist_file}" )
[ -z "${output_file}" ] || compare_args+=( --output "${output_file}" )

verify_exit="0"
"${MYDIR}/dm-reproducible-compare-artifacts" "${compare_args[@]}" || verify_exit="$?"

case "${verify_exit}" in
   0) printf '%s\n' "INFO: REPRODUCIBLE -- the published image matches the local rebuild." >&2 ;;
   1) printf '%s\n' "INFO: NOT reproducible -- differences remain${output_file:+ (report: ${output_file})}." >&2 ;;
   *) printf '%s\n' "ERROR: verification could not complete (exit ${verify_exit})." >&2 ;;
esac
exit "${verify_exit}"
