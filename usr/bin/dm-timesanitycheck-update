#!/bin/bash

## Copyright (C) 2012 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

source /usr/libexec/helper-scripts/git.sh

## XXX: hardcoded path
derivative_maker_source_code_dir="${HOME}/derivative-maker"

minimum_unixtime_file="${derivative_maker_source_code_dir}/packages/kicksecure/dist-system-metadata/usr/share/dist-system-metadata/timesanitycheck/minimum_unixtime"

"${derivative_maker_source_code_dir}/packages/kicksecure/timesanitycheck/usr/share/timesanitycheck/date-minimum-file-create" "${minimum_unixtime_file}"

cd -- "${derivative_maker_source_code_dir}/packages/kicksecure/dist-system-metadata"

if nothing_to_commit; then
  exit 0
fi

git diff HEAD

## This script is only run manually, so we don't care that CI would hang if it
## reached here.
true "press enter to continue"
read -r temp

git add -- 'usr/share/dist-system-metadata/timesanitycheck/minimum_unixtime'
git commit -m 'update minimum_unixtime'

true "$0: INFO: OK"
