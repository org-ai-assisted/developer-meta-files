#!/bin/bash

## Copyright (C) 2012 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

MYDIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )"
cd -- "${MYDIR}"

## This tool lives at
## <derivative-maker>/packages/kicksecure/developer-meta-files/usr/bin; the parent
## repo root (five levels up) holds help-steps. Derive it from our own location so
## the tool works regardless of $HOME or where the checkout lives.
dist_source_root="$( cd -- "${MYDIR}/../../../../.." && pwd )"
if [ ! -f "${dist_source_root}/help-steps/pre" ]; then
   for dist_source_root_candidate in \
      "${DERIVATIVE_MAKER_ROOT:-}" \
      "${source_code_folder_dist:-}" \
      "${HOME:-}/derivative-maker" ; do
      if [ -n "${dist_source_root_candidate}" ] \
         && [ -f "${dist_source_root_candidate}/help-steps/pre" ]; then
         dist_source_root="${dist_source_root_candidate}"
         break
      fi
   done
fi
if [ ! -f "${dist_source_root}/help-steps/pre" ]; then
   printf '%s\n' "ERROR: cannot locate the derivative-maker checkout (no help-steps/pre under '${dist_source_root}'). Run this from a checkout or set DERIVATIVE_MAKER_ROOT." >&2
   exit 1
fi
source "${dist_source_root}/help-steps/pre"
source "${dist_source_root}/help-steps/variables"

error_handler_interactive_chroot_raw_shell() {
   trap "error_handler_interactive_chroot_raw" ERR INT TERM

   printf '%s\n' "${green}INFO${reset}: Exited (1) interactive shell."
   sync
}

error_handler_interactive_chroot_raw() {
   printf '%s\n' "
${red}${bold}BASH_COMMAND${reset}: ${BASH_COMMAND}
${red}${bold}ERROR ${BASH_SOURCE[0]}: | caller: $(caller)${reset}
Unchrooting.. Unpreventing daemons from starting... Unmounting raw...
"

   "${dist_source_help_steps_folder}"/unchroot-raw "$@"
   "${dist_source_help_steps_folder}"/unprevent-daemons-from-starting "$@"
   "${dist_source_help_steps_folder}"/unmount-raw "$@"

   printf '%s\n' "
${red}${bold}BASH_COMMAND${reset}: ${BASH_COMMAND}
${red}${bold}ERROR ${BASH_SOURCE[0]}: | caller: $(caller)${reset}
"

   exit 1
}

main() {
   trap "error_handler_interactive_chroot_raw" ERR INT TERM

   "${dist_source_help_steps_folder}"/mount-raw "$@"

   printf '%s\n' "${cyan}INFO: Trying to prevent daemons from starting, if /usr/sbin/ folder already exist (will fail open, if not)...${reset}"

   "${dist_source_help_steps_folder}"/prevent-daemons-from-starting "$@" || true

   ## Networking should be available. Otherwise use the following.
   #export dist_chroot_mount_resolv_conf="0" "$dist_source_help_steps_folder"/chroot-raw
   "${dist_source_help_steps_folder}"/chroot-raw "$@"

   sync

   ## Sanity tests.
   chroot_run mount
   chroot_run sync

   sync

   printf '%s\n' "${cyan}INFO: Trying to make local APT repository available inside chroot, if already available (will fail open, if not)...${reset}"

   "${dist_source_help_steps_folder}"/create-local-apt-repo "$@" || true

   sync

   ## Info.
   printf '%s\n' "${cyan}INFO: Entering interactive shell...${reset}"
   printf '%s\n' "${cyan}Recommendation: check /home/user if you are really inside the image and not on your host system."
   printf '%s\n' "    When you are done, do not forget to leave the shell using: exit 0${reset}"

   ## Run interactive shell.
   trap "error_handler_interactive_chroot_raw_shell" ERR INT TERM
   chroot_run "/bin/bash"

   printf '%s\n' "${green}INFO: Exited (0) interactive shell.${reset}"

   "${dist_source_help_steps_folder}"/remove-local-apt-repo "$@"

   chroot_run sync
   sync

   "${dist_source_help_steps_folder}"/unchroot-raw "$@"
   "${dist_source_help_steps_folder}"/unprevent-daemons-from-starting "$@"
   "${dist_source_help_steps_folder}"/unmount-raw "$@"

   sync

   printf '%s\n' "${green}INFO: Terminated interactive chroot without any errors.${reset}"
}

main "$@"
