#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Canonicalize the 'Owners:' package lists in a debconf config.dat so the file
## is byte-identical regardless of the build environment.
##
## THE REPRODUCIBILITY BUG THIS FIXES: debconf records, per question, the set of
## packages that own it, in config.dat 'Owners:' lines. The owner is recorded
## with the package name AS dpkg spells it when it runs the config script --
## which is the BARE name ('shim-signed') in one configure phase and the
## ARCH-QUALIFIED name ('shim-signed:amd64') in another. A build that configures
## the package across two phases records BOTH ('Owners: shim-signed,
## shim-signed:amd64'); a build that configures it once records ONE. The two are
## the SAME system, so the difference is pure build-environment noise -- and it
## was the last local-vs-CI difference in a Kicksecure image.
##
## Observed in a CI image: shim-signed, libc6 and libpam0g all carried the dual
## spelling. Verified synthetically that debconf SORTS Owners, so the difference
## is the SET (one spelling vs both), not the order.
##
## THE FIX: strip the ':arch' qualifier from every owner and de-duplicate, so
## 'shim-signed', 'shim-signed:amd64' and 'shim-signed, shim-signed:amd64' all
## collapse to 'shim-signed'. The arch qualifier is never semantically meaningful
## for question ownership, and a later 'db_unregister' of an arch-qualified owner
## that no longer matches simply leaves the question owned by the bare name (a
## harmless orphan at worst) -- the same trade-off Debian's own reproducible
## builds work accepts. ONLY config.dat is touched: templates.dat 'Owners:' hold
## QUESTION names (e.g. 'shim-signed/no-valid-sigs'), not package names.
##
## Idempotent: a normalized file is unchanged by a second run.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

if [ "$#" -ne 1 ]; then
   printf '%s\n' "usage: dm-debconf-normalize-owners <config.dat>" >&2
   exit 2
fi

config_dat="$1"
if [ ! -f "${config_dat}" ]; then
   printf '%s\n' "dm-debconf-normalize-owners: not a file: ${config_dat}" >&2
   exit 2
fi

## Per 'Owners:' line: strip ':arch' from each comma-separated owner, then keep
## first occurrence only (preserving debconf's existing sorted order). Written to
## a temp file and moved into place so an interrupted run cannot leave a
## half-written database. Perl (debconf's own language) is always present where a
## debconf database exists.
tmp_out="$( mktemp -- "${config_dat}.normalize.XXXXXX" )"
# shellcheck disable=SC2317  # reached only via the EXIT trap
cleanup() {
   safe-rm --force -- "${tmp_out}"
}
trap cleanup EXIT

perl -pe '
   if (/^Owners: /) {
      chomp;
      s/^Owners: //;
      my %seen;
      my @owners = grep { length && !$seen{$_}++ }
                   map  { my $o = $_; $o =~ s/:.*//; $o }
                   split /, /, $_;
      $_ = "Owners: " . join(", ", @owners) . "\n";
   }
' -- "${config_dat}" > "${tmp_out}"

## Preserve the original mode/owner: cp the content in, do not rename across it
## (a rename would drop debconf root:root 0600 onto the mktemp default).
cat -- "${tmp_out}" > "${config_dat}"
exit 0
