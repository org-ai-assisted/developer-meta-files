#!/bin/bash

## Copyright (C) 2012 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

MYDIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )"
cd -- "${MYDIR}"

## This tool lives at
## <derivative-maker>/packages/kicksecure/developer-meta-files/usr/bin; the parent
## repo root (five levels up) holds help-steps. Derive it from our own location so
## the tool works regardless of $HOME or where the checkout lives. A system-wide
## install (MYDIR=/usr/bin) derives the filesystem root ('/' or a POSIX-preserved
## '//'), which is never a checkout. Treat the derived root as just the FIRST
## candidate and accept it -- like every explicit fallback -- only when it is not
## the filesystem root and actually holds help-steps/pre. So '/' falls through to
## DERIVATIVE_MAKER_ROOT / source_code_folder_dist / $HOME, and '/help-steps/pre'
## is never sourced.
dist_source_root=""
derived_source_root="$( cd -- "${MYDIR}/../../../../.." && pwd )"
for dist_source_root_candidate in \
   "${derived_source_root}" \
   "${DERIVATIVE_MAKER_ROOT:-}" \
   "${source_code_folder_dist:-}" \
   "${HOME:-}/derivative-maker" ; do
   [ -n "${dist_source_root_candidate}" ] || continue
   ## Reject the filesystem root in ANY spelling ('/', '//', '///', '/.', '/usr/..',
   ## '/proc/self/root', a symlink that resolves to '/'): readlink -m canonicalizes
   ## the path (collapsing '.', '..' and extra slashes and resolving symlinks, with
   ## no existence requirement), so a candidate that resolves to root is never taken
   ## as a checkout and '/help-steps/pre' is never sourced. The ACCEPTED value stays
   ## the original (logical) path, so a symlinked checkout is unaffected.
   if [ "$( readlink -m -- "${dist_source_root_candidate}" )" = "/" ]; then
      continue
   fi
   if [ -f "${dist_source_root_candidate}/help-steps/pre" ]; then
      dist_source_root="${dist_source_root_candidate}"
      break
   fi
done
if [ -z "${dist_source_root}" ]; then
   printf '%s\n' "ERROR: cannot locate the derivative-maker checkout (no help-steps/pre found). Run this from a checkout or set DERIVATIVE_MAKER_ROOT." >&2
   exit 1
fi
source "${dist_source_root}/help-steps/pre"
source "${dist_source_root}/help-steps/variables"

main() {
   trap "exception_handler_unchroot_unmount" ERR INT TERM

   sync

   "${dist_source_help_steps_folder}/mount-raw" "$@"

   dist_chroot_mount_resolv_conf="0" "${dist_source_help_steps_folder}/chroot-raw" "$@"

   sync

   ## Sanity test.
   chroot_run sync

   sync

   ## We have to manually fix /etc/apt/sources.list, because the list which comes with
   ## grml-debootstrap is incomplete (does not complain debian security repository) and points to 127.0.0.1.

   ## This file doesn't include the derivative's APT repository.
   ## CHROOT_FOLDER is the root-owned mounted image fs; this tool runs as the
   ## unprivileged build user, so the write needs SUDO_TO_ROOT.
   ${SUDO_TO_ROOT} cp -- "${source_code_folder_dist}/packages/kicksecure/anon-apt-sources-list/etc/apt/sources.list.d/debian.sources" "${CHROOT_FOLDER}/etc/apt/sources.list.d/debian.sources"
   ${SUDO_TO_ROOT} chmod o+r -- "${CHROOT_FOLDER}/etc/apt/sources.list.d/debian.sources"

   sync

   "${dist_source_help_steps_folder}/create-local-apt-repo" "$@"

   ## Check if we are running on a Whonix-Gateway.
   if [ -f "/usr/share/anon-gw-base-files/gateway" ]; then
      true 'INFO: We are running on a Whonix-Gateway, setting UWT_DEV_PASSTHROUGH="0", ok.'

      ## Someone trying to update Whonix-Gateway from source code. By default,
      ## export UWT_DEV_PASSTHROUGH="1" has been set in help-steps/variables.
      ## This won't work from within an installed Whonix-Gateway, because it by
      ## design does not have functional system DNS.
      export UWT_DEV_PASSTHROUGH="0"
   fi

   ## Reading [apt repository containing snapshot.debian.org and] local repository containing Whonix's packages.
   chroot_run apt-get "${DIST_APTGETOPT[@]}" ${apt_sourcelist_empty} ${apt_sourceparts} -o APT::Get::List-Cleanup="0" update

   ## Upgrade Whonix Debian Packages.
   chroot_run apt-get "${DIST_APTGETOPT[@]}" ${apt_sourcelist_empty} ${apt_sourceparts} --yes dist-upgrade

   "${dist_source_help_steps_folder}/remove-local-apt-repo" "$@"

   ## Forget about local repository containing Whonix's packages.
   chroot_run apt-get --no-download --list-cleanup update

   chroot_run sync
   sync

   "${dist_source_help_steps_folder}/unchroot-raw" "$@"
   "${dist_source_help_steps_folder}/unmount-raw" "$@"

   sync
}

main "$@"
