#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Download a published image plus its reproducibility sidecars into a local
## directory. The image is UNTRUSTED -- only fetched, never executed, booted or
## verified; verification + rebuild + compare is the separate
## 'dm-reproducible-verify'. Run with --help for details.


## No minimum-version check: images predating reproducible-build support are
## non-reproducible, but there is no hard block -- someone can still investigate a
## historical image if they want to.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

MYDIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )"

## style-ok: no-has
## Self-contained downloader (runs outside a build tree); probes for scurl/curl
## with 'command -v' rather than sourcing the 'has' helper.

me="${0##*/}"

print_usage() {
   printf '%s\n' \
      "Usage:" \
      "  ${me} URL [--output-dir DIR]" \
      "  ${me} --url IMAGE_URL [--output-dir DIR]" \
      "  ${me} --version VER --arch ARCH --target TARGET --flavor FLAVOR [--project DOMAIN] [--output-dir DIR]"
}

print_help() {
   print_usage
   printf '%s\n' \
      "" \
      "Pass EITHER a published version OR a full download URL; exactly one is" \
      "required. A URL is self-contained (version, arch, project and target are" \
      "parsed from it), so give it as a bare positional or via --url. A version" \
      "cannot encode arch/target/flavor, so give it via --version plus those" \
      "flags -- never as a bare positional." \
      "" \
      "  --version VER      published version, e.g. 18.2.1.7." \
      "  --url IMAGE_URL    full download URL." \
      "  --arch ARCH        amd64 | arm64 (mandatory with --version; never defaulted)." \
      "  --target TARGET    iso | virtualbox | raw | qcow2 (with --version)." \
      "  --flavor FLAVOR    kicksecure-{lxqt,cli,debug} | whonix-{gateway,workstation}-{cli,lxqt}" \
      "                     (with --version)." \
      "  --project DOMAIN   download domain (default: kicksecure.com for kicksecure-*," \
      "                     whonix.org for whonix-*)." \
      "  --output-dir DIR   where to place the downloads (default: current dir)." \
      "" \
      "Then verify with: dm-reproducible-verify DIR/<image>" \
      "Exit codes: 0 all sidecars fetched; 2 usage / download error."
}

error() {
   printf '%s\n' "ERROR: $*" >&2
   exit 2
}

url=""
out_dir="."
version=""
target=""
flavor=""
arch=""
## Empty by default; defaulted from the flavor's project (kicksecure.com /
## whonix.org) after parsing, unless --project overrides it.
project=""

while [ "$#" -gt 0 ]; do
   case "${1:-}" in
      --output-dir)
         [ "$#" -ge 2 ] || error "--output-dir requires a value."
         out_dir="$2"
         shift 2
         ;;
      --url)
         [ "$#" -ge 2 ] || error "--url requires a value."
         url="$2"
         shift 2
         ;;
      --version)
         [ "$#" -ge 2 ] || error "--version requires a value."
         version="$2"
         shift 2
         ;;
      --target)
         [ "$#" -ge 2 ] || error "--target requires a value."
         target="$2"
         shift 2
         ;;
      --flavor)
         [ "$#" -ge 2 ] || error "--flavor requires a value."
         flavor="$2"
         shift 2
         ;;
      --arch)
         [ "$#" -ge 2 ] || error "--arch requires a value."
         arch="$2"
         shift 2
         ;;
      --project)
         [ "$#" -ge 2 ] || error "--project requires a value."
         project="$2"
         shift 2
         ;;
      -h|--help)
         print_help
         exit 0
         ;;
      -*)
         error "unknown option: '$1' (run with --help)."
         ;;
      *)
         ## A bare positional is accepted ONLY as a URL, which is self-contained
         ## (version, arch, project and target are parsed from it). A published
         ## version cannot encode those, so it must be explicit via --version.
         case "$1" in
            *://*)
               [ -z "${url}" ] || error "URL given more than once."
               url="$1"
               ;;
            *)
               error "unexpected argument '$1'; a bare positional must be a URL. For a published version use --version VER --arch ARCH --target TARGET --flavor FLAVOR (see --help)."
               ;;
         esac
         shift
         ;;
   esac
done

[ -z "${url}" ] || [ -z "${version}" ] || error "pass EITHER --version OR --url, not both."
[ -n "${url}" ] || [ -n "${version}" ] || { print_usage >&2; error "pass a published version (--version) or a URL"; }

## Shared map of build target <-> released url_part + extension (also used by
## dm-reproducible-compare-artifacts), so the download URL, the comparison, and
## the URL-mode detection all use the same forward and reverse mappings and can
## never drift. Sourced here -- after -h/--help and the usage errors above have
## exited -- so those need no helper-scripts. The map sources helper-scripts'
## strings.bsh via HELPER_SCRIPTS_PATH; default it to the installed location so
## an installed run resolves it without the build env.
HELPER_SCRIPTS_PATH="${HELPER_SCRIPTS_PATH:-}"
# shellcheck source=../libexec/developer-meta-files/reproducible-target-map.bsh
source "${MYDIR}/../libexec/developer-meta-files/reproducible-target-map.bsh"

## VERSION mode: build the download URL. Mirrors the image naming in
## help-steps/variables:
##   https://download.<domain>/<url_part>/<version>/<image-name>-<version>.<arch_pretty>.<ext>
## where <image-name> is Kicksecure-<desktop> or Whonix-<role>-<desktop> (set in
## the flavor case below). A naming drift here just yields a 404, never a wrong
## download.
if [ -n "${version}" ]; then
   [ -n "${arch}" ]   || error "--version requires --arch (see --help); it is not defaulted."
   [ -n "${target}" ] || error "--version requires --target (see --help)."
   [ -n "${flavor}" ] || error "--version requires --flavor (see --help)."

   ## The published image name mirrors the build's own naming in
   ## help-steps/variables: Kicksecure is 'Kicksecure-<desktop>', Whonix is
   ## 'Whonix-<Gateway|Workstation>-<desktop>' (Whonix ships gateway and
   ## workstation as separate images, so its flavor carries the role too).
   case "${flavor}" in
      kicksecure-lxqt)
         image_name_base="Kicksecure-LXQt"
         ;;
      kicksecure-cli)
         image_name_base="Kicksecure-CLI"
         ;;
      kicksecure-debug)
         image_name_base="Kicksecure-Debug"
         ;;
      whonix-gateway-cli)
         image_name_base="Whonix-Gateway-CLI"
         ;;
      whonix-gateway-lxqt)
         image_name_base="Whonix-Gateway-LXQt"
         ;;
      whonix-workstation-cli)
         image_name_base="Whonix-Workstation-CLI"
         ;;
      whonix-workstation-lxqt)
         image_name_base="Whonix-Workstation-LXQt"
         ;;
      *)
         error "unsupported --flavor '${flavor}' (kicksecure-{lxqt,cli,debug} | whonix-{gateway,workstation}-{cli,lxqt})."
         ;;
   esac

   ## Default the download domain from the flavor's project when not given.
   if [ -z "${project}" ]; then
      case "${flavor}" in
         whonix-*)
            project="whonix.org"
            ;;
         *)
            project="kicksecure.com"
            ;;
      esac
   fi

   case "${arch}" in
      amd64)
         arch_pretty="Intel_AMD64"
         ;;
      arm64)
         arch_pretty="arm64"
         ;;
      *)
         error "unsupported --arch '${arch}' (amd64|arm64)."
         ;;
   esac

   url_part=""
   ext=""
   dm_reproducible_target_url_part url_part "${target}" \
      || error "unsupported --target '${target}' (iso|virtualbox|raw|qcow2)."
   dm_reproducible_target_ext ext "${target}"

   url="https://download.${project}/${url_part}/${version}/${image_name_base}-${version}.${arch_pretty}.${ext}"
   printf '%s\n' "INFO: built download URL from --version: ${url}" >&2
fi

## URL mode: auto-detect version, project, target and arch from the link, but
## only when the URL actually matches the published layout
## (.../<url_part>/<version>/Kicksecure-...). Otherwise report nothing detected
## rather than manufacture misleading values. The download always uses the URL
## verbatim, so detection is purely informational.
if [ -n "${url}" ] && [ -z "${version}" ]; then
   det_hostpath="${url#*://}"
   det_host="${det_hostpath%%/*}"
   det_project="${det_host#download.}"
   det_pathonly="${det_hostpath#*/}"
   det_url_part="${det_pathonly%%/*}"
   det_afterpart="${det_pathonly#*/}"
   det_version="${det_afterpart%%/*}"
   det_file="$(basename -- "${url%%\?*}")"
   det_after="${det_file#*-"${det_version}".}"
   det_arch_pretty="${det_after%%.*}"
   dm_reproducible_url_part_to_target det_target "${det_url_part}" || det_target=""
   case "${det_arch_pretty}" in
      Intel_AMD64)
         det_arch="amd64"
         ;;
      *)
         det_arch="${det_arch_pretty}"
         ;;
   esac
   if [ -n "${det_target}" ] && [ "${det_file#Kicksecure-}" != "${det_file}" ]; then
      printf '%s\n' "INFO: detected from URL: project=${det_project} target=${det_target} version=${det_version} arch=${det_arch}" >&2
   else
      printf '%s\n' "INFO: URL not in the recognized download layout; fetching verbatim (no metadata detected)." >&2
   fi
fi
command -v scurl >/dev/null 2>&1 || command -v curl >/dev/null 2>&1 || error "neither scurl nor curl found."

mkdir --parents -- "${out_dir}"

## Resumable, https-only. scurl (hardened wrapper) preferred.
fetch() {
   local src="$1" dst="$2"
   local dl=( curl --tlsv1.3 --proto '=https' --location --fail --retry 5 --retry-all-errors --retry-delay 10 --continue-at - )
   if command -v scurl >/dev/null 2>&1; then
      dl=( scurl --location --fail --retry 5 --retry-all-errors --retry-delay 10 --continue-at - )
   fi
   "${dl[@]}" --output "${dst}" -- "${src}" || error "download failed: ${src}"
}

image_name="$(basename -- "${url%%\?*}")"
dest="${out_dir}/${image_name}"

printf '%s\n' "INFO: fetching image (UNTRUSTED) + reproducibility sidecars into '${out_dir}'..." >&2
fetch "${url}"                    "${dest}"
fetch "${url}.dm-buildinfo"       "${dest}.dm-buildinfo"
fetch "${url}.dm-buildinfo.asc"   "${dest}.dm-buildinfo.asc"
fetch "${url}.dm-buildinfo.sig"   "${dest}.dm-buildinfo.sig"
fetch "${url}.sha512sums"         "${dest}.sha512sums"
fetch "${url}.sha512sums.asc"     "${dest}.sha512sums.asc"
fetch "${url}.sha512sums.sig"     "${dest}.sha512sums.sig"

printf '%s\n' "INFO: downloaded to '${dest}'." >&2
printf '%s\n' "INFO: verify with: dm-reproducible-verify '${dest}'" >&2
