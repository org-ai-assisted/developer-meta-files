## AI-Assisted

# shellcheck shell=bash

## Resolved per-.deb CycloneDX SBOM archive (two-tier SBOM, tier B).
##
## genmkfile's 'sbom' target emits the SOURCE-tree SBOM (tier A): declared licenses and
## dependency NAMES, no versions, no hashes. This tier instead records what was actually
## BUILT: for each binary package, a RESOLVED SBOM -- the binary's content hashes, its
## source package, and the binary->source edge -- generated by 'debsbom --from-pkglist'
## against the local reprepro index. No dependency-closure expansion: the scope is the
## one .deb and its source, not the transitive graph.
##
## Reproducible by construction: a DETERMINISTIC serial (UUID5 of the package identity)
## and the changelog release date as the timestamp, so re-archiving an unchanged .deb is
## byte-identical. debsbom would otherwise mint a random serial and a wall-clock timestamp.
##
## CDX only. debsbom's SPDX output needs python3-spdx-tools, which is not packaged for
## Debian trixie (testing/unstable only); add a '--sbom-type spdx' pass here once it is.
##
## Executable AND source-able: run it as
##   dm-sbom-archive <repo_dir> <archive_dir> <repo_name>
## from a package source dir, or source it and call the pure functions (unit tests do).

## provides was_executed
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh || true
if ! declare -F was_executed >/dev/null; then
   printf '%s\n' "$0: ERROR: cannot source check_runtime.bsh!" >&2
   exit 1
fi

## Build a minimal apt-lists root from a reprepro repo. 'debsbom --from-pkglist' reads a
## package's hashes, source and dependencies from <root>/var/lib/apt/lists/*_Packages.
## Symlink the Release plus EVERY component's binary-<arch> Packages, so a package resolves
## no matter which component or build arch it landed in.
sbom_archive_apt_root() {
   local repo_dir="$1"
   local codename="$2"
   local root_dir="$3"

   local lists_dir="${root_dir}/var/lib/apt/lists"
   mkdir --parents -- "${lists_dir}"
   ln --symbolic --force -- \
      "${repo_dir}/dists/${codename}/Release" "${lists_dir}/${codename}_Release"

   local packages_file relative
   for packages_file in "${repo_dir}/dists/${codename}"/*/binary-*/Packages; do
      [ -f "${packages_file}" ] || continue
      ## main/binary-amd64/Packages -> local_main_binary-amd64_Packages (apt's own naming).
      relative="${packages_file#"${repo_dir}/dists/${codename}/"}"
      relative="${relative//\//_}"
      ln --symbolic --force -- \
         "${packages_file}" "${lists_dir}/${codename}_${relative}"
   done
}

## Deterministic CycloneDX serial for one package identity (UUID5, URL namespace). Pins
## the serial that debsbom would otherwise randomize, so the SBOM stays reproducible.
sbom_archive_serial() {
   uuidgen --sha1 --namespace @url --name "deb/$1/$2/$3"
}

## The single codename under the repo's dists/ (aptrepo_local carries exactly one). Fails
## loud if there is not exactly one, so a wrong/empty repo path cannot silently resolve to
## a literal '*' glob (find would then error on a nonexistent dir).
sbom_archive_codename() {
   local repo_dir="$1"
   local dir count=0 codename=''
   for dir in "${repo_dir}"/dists/*/; do
      [ -d "${dir}" ] || continue
      codename="$(basename -- "${dir}")"
      count=$(( count + 1 ))
   done
   if [ "${count}" -ne 1 ]; then
      printf '%s\n' "ERROR: sbom_archive_codename: expected one codename under '${repo_dir}/dists', found ${count}." >&2
      return 1
   fi
   printf '%s\n' "${codename}"
}

## True when the exact (name, version, arch) binary is present in the reprepro index -- i.e.
## it was actually built for this host and added. A binary package named in debian/control
## but not produced for a given arch is legitimately absent, so the caller SKIPS it rather
## than treating a missing SBOM as an error; a package that IS present but will not resolve
## is a real fault that sbom_archive_one fails on.
sbom_archive_present() {
   local repo_dir="$1"
   local codename="$2"
   local name="$3"
   local version="$4"
   local arch="$5"

   local packages_file count total=0
   for packages_file in "${repo_dir}/dists/${codename}"/*/binary-*/Packages; do
      [ -f "${packages_file}" ] || continue
      count="$(grep-dctrl \
         --exact-match --field=Package "${name}" \
         --and --exact-match --field=Version "${version}" \
         --and --exact-match --field=Architecture "${arch}" \
         --count "${packages_file}")"
      total=$(( total + count ))
   done
   [ "${total}" -gt 0 ]
}

## Archive one binary package's SBOM IF it is in the index for this arch; INFO-skip if not
## (an arch the package was not built for). So a missing .deb neither aborts the batch nor
## passes silently.
sbom_archive_if_present() {
   local repo_dir="$1"
   local codename="$2"
   local name="$3"
   local version="$4"
   local pkg_arch="$5"
   local distro_arch="$6"
   local source_date_epoch="$7"
   local archive_dir="$8"

   if ! sbom_archive_present "${repo_dir}" "${codename}" "${name}" "${version}" "${pkg_arch}"; then
      printf '%s\n' "INFO: sbom_archive: '${name}' ${version} ${pkg_arch} not in the index; skipping."
      return 0
   fi
   sbom_archive_one \
      "${repo_dir}" "${codename}" "${name}" "${version}" \
      "${pkg_arch}" "${distro_arch}" "${source_date_epoch}" "${archive_dir}" >/dev/null
}

## Generate and write the resolved CDX SBOM for ONE binary package.
##   repo_dir codename name version pkg_arch distro_arch source_date_epoch archive_dir
## pkg_arch is the package's own Architecture ('all' or e.g. 'amd64'); distro_arch is the
## native build architecture debsbom resolves source/native references against.
sbom_archive_one() {
   local repo_dir="$1"
   local codename="$2"
   local name="$3"
   local version="$4"
   local pkg_arch="$5"
   local distro_arch="$6"
   local source_date_epoch="$7"
   local archive_dir="$8"

   local root_dir serial timestamp out
   root_dir="$(mktemp --directory)"
   sbom_archive_apt_root "${repo_dir}" "${codename}" "${root_dir}"

   serial="$(sbom_archive_serial "${name}" "${version}" "${pkg_arch}")"
   timestamp="$(date --utc --date="@${source_date_epoch}" +%Y-%m-%dT%H:%M:%SZ)"

   mkdir --parents -- "${archive_dir}"
   ## Filename follows .deb convention (epoch stripped); the pkglist keeps the FULL version
   ## (with epoch) so it matches the reprepro index exactly.
   out="${archive_dir}/${name}_${version##*:}_${pkg_arch}.cdx.json"
   ## debsbom appends '.cdx.json' to --out, so strip it from the target path. The pkglist
   ## line debsbom reads from stdin is 'name version arch'.
   printf '%s\n' "${name} ${version} ${pkg_arch}" \
      | debsbom generate \
           --from-pkglist \
           --root "${root_dir}" \
           --sbom-type cdx \
           --cdx-serialnumber "${serial}" \
           --timestamp "${timestamp}" \
           --distro-arch "${distro_arch}" \
           --out "${out%.cdx.json}"

   safe-rm --recursive --force -- "${root_dir}"

   ## Resolution guard: an SBOM whose components carry no content hashes means debsbom did
   ## not find the package in the index (a name/version/arch mismatch). debsbom only WARNS
   ## in that case, so without this check Track B would silently archive a hash-less record
   ## that defeats its own purpose. Fail loud instead.
   if ! jq --exit-status '[.components[]? | select((.hashes // []) | length > 0)] | length > 0' \
         "${out}" >/dev/null; then
      ## Remove the unresolved file so a later run's 'git add --all' cannot commit a
      ## hash-less record.
      safe-rm --force -- "${out}"
      printf '%s\n' \
         "ERROR: sbom_archive_one: '${name} ${version} ${pkg_arch}' did not resolve in the reprepro index (no hashes); unresolved SBOM discarded." >&2
      return 1
   fi
   printf '%s\n' "${out}"
}

## Commit the archive to its local git repo. Local-only by design: a resolved SBOM embeds
## the exact .deb content hashes of THIS host's build artifacts -- a provenance record kept
## beside the build, never pushed. A no-op when nothing changed.
sbom_archive_commit() {
   local archive_dir="$1"
   local message="$2"

   mkdir --parents -- "${archive_dir}"
   if [ ! -d "${archive_dir}/.git" ]; then
      git -C "${archive_dir}" init --quiet
   fi
   git -C "${archive_dir}" add --all
   if git -C "${archive_dir}" diff --cached --quiet; then
      return 0
   fi
   ## ALLOW_STYLE_COMMIT: the archive holds debsbom's CANONICAL output, kept byte-for-byte
   ## so each SBOM stays a faithful, reproducible provenance record. The source-style gate
   ## (end-of-file-fixer, pretty-format-json) would rewrite that generated JSON; the PII,
   ## secret and commit-message guards still run.
   ALLOW_STYLE_COMMIT=1 git \
      -C "${archive_dir}" \
      -c "user.name=${DEBFULLNAME:-derivative-maker}" \
      -c "user.email=${DEBEMAIL:-dm@local}" \
      commit --quiet --message "${message}"
}

## Archive every binary package of the package in the CURRENT directory, then commit.
##   repo_dir archive_dir repo_name
## Reads debian/control (binary package list) and debian/changelog (version, release date)
## from the working directory. Scope: the binary packages DECLARED in debian/control -- not
## auto-generated debug-symbol (-dbgsym) packages, which are debug artifacts, not shipped
## deliverables. An 'all' package yields one arch-independent .deb; an arch-dependent package
## yields one per built arch (make_cross_build_platform_list), archived only for the arches
## actually in the index (sbom_archive_if_present skips the rest instead of aborting).
sbom_archive_run() {
   local repo_dir="$1"
   local archive_dir="$2"
   local repo_name="$3"

   local control_file='debian/control'
   [ -f "${control_file}" ] || return 0

   ## reprepro-add JUST populated this repo; a missing one means the caller's derived path is
   ## wrong -- fail loud rather than silently archive nothing.
   if [ ! -d "${repo_dir}/dists" ]; then
      printf '%s\n' "ERROR: sbom_archive_run: reprepro repo not found at '${repo_dir}'." >&2
      return 1
   fi

   local codename native_arch version source_date_epoch arch_list
   codename="$(sbom_archive_codename "${repo_dir}")"
   native_arch="$(dpkg --print-architecture)"
   version="$(dpkg-parsechangelog --show-field Version)"
   source_date_epoch="$(dpkg-parsechangelog --show-field Timestamp)"
   arch_list="${make_cross_build_platform_list:-${native_arch}}"

   local stanza_list line package binary_architecture build_arch
   stanza_list="$(grep-dctrl --show-field=Package,Architecture '' "${control_file}")"
   package=""
   binary_architecture=""
   while IFS= read -r line; do
      case "${line}" in
         "Package: "*)
            package="${line#Package: }"
            ;;
         "Architecture: "*)
            binary_architecture="${line#Architecture: }"
            if [ "${binary_architecture}" = "all" ]; then
               sbom_archive_if_present \
                  "${repo_dir}" "${codename}" "${package}" "${version}" \
                  all "${native_arch}" "${source_date_epoch}" "${archive_dir}"
            else
               for build_arch in ${arch_list}; do
                  sbom_archive_if_present \
                     "${repo_dir}" "${codename}" "${package}" "${version}" \
                     "${build_arch}" "${build_arch}" "${source_date_epoch}" "${archive_dir}"
               done
            fi
            ;;
      esac
   done <<< "${stanza_list}"

   sbom_archive_commit "${archive_dir}" "sbom: ${repo_name} ${version}"
}

main() {
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose
   export LC_ALL=C

   if [ "$#" -ne 3 ]; then
      printf '%s\n' "Usage: ${0##*/} <repo_dir> <archive_dir> <repo_name>" >&2
      exit 1
   fi
   sbom_archive_run "$@"
}

## Only auto-run when executed, not when sourced (unit tests source it).
if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
