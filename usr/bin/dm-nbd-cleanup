#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Release leaked nbd devices and the mounts sitting on them.
##
## Usage: dm-nbd-cleanup [--release]

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/strings.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/strings.bsh

dry_run=""

print_usage() {
   printf '%s\n' "Usage:
  ${0##*/} [--release]"
}

print_help() {
   print_usage
   printf '%s\n' "
Reports (and optionally releases) leaked nbd devices and the mounts sitting
on them.

  --release   unmount nbd mounts and disconnect the in-use devices
  --dry-run   report only, take no action (enabled by default)
  -h, --help  show this help"
}

while [ "$#" -gt 0 ]; do
   case "$1" in
      --release)
         if [ -n "${dry_run}" ]; then
            printf '%s\n' "${0##*/}: --release and --dry-run are mutually exclusive!" >&2
            exit 2
         fi
         dry_run=false
         shift
         ;;
      --dry-run)
         if [ -n "${dry_run}" ]; then
            printf '%s\n' "${0##*/}: --release and --dry-run are mutually exclusive!" >&2
            exit 2
         fi
         dry_run=true
         shift
         ;;
      -h|--help)
         print_help
         exit 0
         ;;
      *)
         printf '%s\n' "${0##*/}: unknown argument: '${1}'" >&2
         exit 2
         ;;
   esac
done

## Opt-in by design.
default_if_empty dry_run 'true'

## Identify nbd-backed mounts from /proc/self/mountinfo (kernel-written), not the
## attacker-controllable /proc/mounts source STRING. Two kernel truths together, so
## neither a spoof nor an anonymous-superblock filesystem slips:
##  - field 3 (major:minor) is the mount's st_dev. A filesystem mounted DIRECTLY on
##    the block device (ext4, xfs, ...) reports the nbd major (NBD_MAJOR 43), which
##    an unprivileged user cannot forge.
##  - btrfs and other anonymous-superblock filesystems report st_dev major 0, so the
##    major alone would MISS a genuine nbd-backed btrfs -- the tool would then
##    disconnect the device under a live mount. For those, fall back to the mount
##    SOURCE matching /dev/nbd*, but ONLY when the filesystem TYPE is a real block
##    filesystem (listed in /proc/filesystems WITHOUT the 'nodev' flag). The kernel
##    sets the type; an unprivileged FUSE / tmpfs spoof (fsname /dev/nbd0) is a
##    'nodev' type and is rejected -- this is what closes the confused-deputy.
## The overridable inputs let a test drive the release path against fixtures without
## root; DM_NBD_CLEANUP_PROC_MOUNTINFO also marks a test run (skips the block-device
## probe, which a rootless test cannot satisfy).
proc_mountinfo="${DM_NBD_CLEANUP_PROC_MOUNTINFO:-/proc/self/mountinfo}"
proc_filesystems="${DM_NBD_CLEANUP_PROC_FILESYSTEMS:-/proc/filesystems}"

## NBD_MAJOR is a static kernel allocation (include/uapi/linux/major.h).
nbd_major='43'

## Space-delimited set of real (non-'nodev') block filesystem types, for a
## substring test below. A 'nodev' line (tmpfs, fuse, overlay, ...) is a virtual /
## userspace filesystem an unprivileged user can mount with a forged source string.
block_fs_types=' '
while read -r fs_flag_or_type _; do
   ## '<tab>ext4' -> $1=ext4 (block); 'nodev<tab>tmpfs' -> $1=nodev (virtual).
   if [ "${fs_flag_or_type}" != "nodev" ] && [ -n "${fs_flag_or_type}" ]; then
      block_fs_types+="${fs_flag_or_type} "
   fi
done < "${proc_filesystems}"

## Probe the whole range, not just nbd0. Keying on /dev/nbd0 alone missed a
## leaked /dev/nbd1 on a host where node 0 was absent, and exited 0 reporting
## nothing to do. In production this early exit also means a host with no nbd node
## never reaches the mount loop -- so a spoofed non-nbd mount whose source string
## merely looks like /dev/nbd* cannot be reached there. Skipped only for a fixture
## (test) run.
if [ -z "${DM_NBD_CLEANUP_PROC_MOUNTINFO:-}" ]; then
   nbd_present=false
   for nbd_probe in /dev/nbd[0-9] /dev/nbd[0-9][0-9]; do
      if [ -b "${nbd_probe}" ]; then
         nbd_present=true
         break
      fi
   done
   if [ "${nbd_present}" = "false" ]; then
      printf '%s\n' "${0##*/}: no /dev/nbd* devices; nothing to release."
      exit 0
   fi
fi

## Collect every nbd-backed mountpoint. Snapshot the full list BEFORE unmounting
## any: unmounting mutates mountinfo while we read it, so a live read would skip
## later entries.
## mountinfo line: ID PARENT MAJ:MIN ROOT MOUNTPOINT OPTS [OPTIONAL...] - FS SRC OPTS
nbd_mount_points=()
while IFS= read -r mounts_line; do
   ## Split at the ' - ' field separator (mountinfo escapes spaces as \040, so a
   ## literal ' - ' only ever appears as that separator).
   mounts_pre="${mounts_line%% - *}"
   mounts_post="${mounts_line#* - }"
   read -r _ _ mounts_majmin _ mounts_point _ <<< "${mounts_pre}"
   read -r mounts_fstype mounts_source _ <<< "${mounts_post}"

   mounts_is_nbd='false'
   if [ "${mounts_majmin%%:*}" = "${nbd_major}" ]; then
      ## Block filesystem mounted directly on the nbd device (ext4, xfs, ...).
      mounts_is_nbd='true'
   elif [[ "${mounts_source}" =~ ^/dev/nbd[0-9]+(p[0-9]+)?$ ]] \
      && [[ "${block_fs_types}" == *" ${mounts_fstype} "* ]]; then
      ## Anonymous-superblock block filesystem (btrfs, ...) whose kernel-set type
      ## proves it is a real block fs -- not a forgeable 'nodev' spoof. Match the
      ## EXACT nbd device/partition name (/dev/nbdN or /dev/nbdNpM) so a same-prefix
      ## name (/dev/nbd-backup, /dev/nbd0-backup) cannot match. Known limitation: a
      ## MULTI-device btrfs whose mountinfo source is a non-nbd member (btrfs
      ## reports only latest_dev) is not caught here; that needs btrfs member
      ## enumeration, out of scope for this cleanup.
      mounts_is_nbd='true'
   fi
   if [ "${mounts_is_nbd}" != 'true' ]; then
      continue
   fi

   printf -v mounts_point_decoded '%b' "${mounts_point}"
   nbd_mount_points+=( "${mounts_point_decoded}" )
done < "${proc_mountinfo}"

release_failures=0
released_mounts=0
for mount_point in "${nbd_mount_points[@]}"; do
   [ -n "${mount_point}" ] || continue
   if [ "${dry_run}" = "true" ]; then
      printf '%s\n' "  would umount ${mount_point}"
      released_mounts=$(( released_mounts + 1 ))
      continue
   fi
   ## No '--lazy', cannot be safely used unless a reboot is imminent. The
   ## caller must kill any processes keeping a mount busy.
   if sudo --non-interactive umount -- "${mount_point}" 2>/dev/null; then
      printf '%s\n' "  umounted ${mount_point}"
      released_mounts=$(( released_mounts + 1 ))
   else
      printf '%s\n' "  FAILED to umount ${mount_point}" >&2
      release_failures=$(( release_failures + 1 ))
   fi
done

released_devices=0
for nbd_device in /dev/nbd[0-9] /dev/nbd[0-9][0-9]; do
   [ -b "${nbd_device}" ] || continue
   ## An unconnected device has size 0 and can be skipped.
   size_path="/sys/block/${nbd_device##*/}/size"
   [ -r "${size_path}" ] || continue
   if ! read -r nbd_size < "${size_path}"; then
      printf '%s\n' "  FAILED to check size of ${nbd_device}"
      release_failures=$(( release_failures + 1 ))
      continue
   fi
   if [ "${nbd_size}" = "0" ]; then
      continue
   fi
   if [ "${dry_run}" = "true" ]; then
      printf '%s\n' "  would disconnect ${nbd_device}"
      released_devices=$(( released_devices + 1 ))
      continue
   fi
   if sudo --non-interactive qemu-nbd --disconnect -- "${nbd_device}" >/dev/null 2>&1; then
      printf '%s\n' "  disconnected ${nbd_device}"
      released_devices=$(( released_devices + 1 ))
   else
      printf '%s\n' "  FAILED to disconnect ${nbd_device}" >&2
      release_failures=$(( release_failures + 1 ))
   fi
done

summary_suffix=""
if [ "${dry_run}" = "true" ]; then
   summary_suffix=" -- REPORT ONLY, pass --release to act"
fi
printf '%s\n' "${0##*/}: ${released_mounts} mount(s), ${released_devices} device(s)${summary_suffix}"

if [ "${release_failures}" -gt 0 ]; then
   printf '%s\n' "${0##*/}: ${release_failures} operation(s) FAILED; nbd is not clean." >&2
   exit 1
fi
