#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Release leaked nbd devices and the mounts sitting on them.
##
## WHY THIS EXISTS: image comparison and inspection run inside the
## derivative-maker container, which is torn down with SIGKILL. Its EXIT traps
## therefore never run, and because the container is --privileged with /dev
## shared, the mounts it made survive in the HOST namespace. The next inspection
## then attaches a DIFFERENT image to the same /dev/nbdN while a stale mount
## still points at it, and every read returns EIO -- which looks like a corrupt
## image rather than a stale mount.
##
## Cost when that happened: a debugging detour chasing "I/O error" on a
## perfectly good CI image. The tell is the same device appearing twice in
## `mount`, one of them at a path nobody remembers creating.
##
## REPORTS BY DEFAULT; --release is required to act. Releasing every active nbd
## device unconditionally would break a concurrent job that is legitimately using
## one, and this tool cannot tell a leaked device from a busy one -- both look
## like "attached with a mount". So the destructive step is opt-in, and the
## default output is the evidence you need to decide.
##
## Usage: dm-nbd-cleanup [--release]

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

## Inverted on purpose: see the header. Acting is the opt-in.
dry_run=true

print_usage() {
   printf '%s\n' \
      "Usage:" \
      "  ${0##*/} [--release]"
}

print_help() {
   print_usage
   printf '%s\n' \
      "" \
      "Release leaked nbd devices and the mounts sitting on them; reports by" \
      "default, so --release is required to act." \
      "" \
      "  --release   unmount nbd mounts and disconnect the in-use devices" \
      "  --dry-run   report only, take no action (the default)" \
      "  -h, --help  show this help"
}

while [ "$#" -gt 0 ]; do
   case "$1" in
      --release)
         dry_run=false
         shift
         ;;
      --dry-run)
         ## Accepted so an explicit dry-run reads naturally; it is the default.
         dry_run=true
         shift
         ;;
      -h|--help)
         print_help
         exit 0
         ;;
      *)
         printf '%s\n' "${0##*/}: unknown argument: '${1}'" >&2
         exit 2
         ;;
   esac
done

## Probe the whole range, not just nbd0. Keying on /dev/nbd0 alone missed a
## leaked /dev/nbd1 on a host where node 0 was absent, and exited 0 reporting
## nothing to do.
nbd_present=false
for nbd_probe in /dev/nbd[0-9] /dev/nbd[0-9][0-9]; do
   if [ -e "${nbd_probe}" ]; then
      nbd_present=true
      break
   fi
done
if [ "${nbd_present}" = "false" ]; then
   printf '%s\n' "${0##*/}: no /dev/nbd* devices; nothing to release."
   exit 0
fi

## Unmount FIRST, then disconnect. A disconnect while a mount still holds the
## device is what leaves the unreadable half-state this exists to clear.
release_failures=0
released_mounts=0
while IFS= read -r mount_point; do
   [ -n "${mount_point}" ] || continue
   if [ "${dry_run}" = "true" ]; then
      printf '%s\n' "  would umount ${mount_point}"
      released_mounts=$(( released_mounts + 1 ))
      continue
   fi
   ## --lazy: a container that died mid-read can leave a process holding the
   ## mount, and EBUSY here would leave exactly the state being cleaned up.
   if sudo --non-interactive umount --lazy -- "${mount_point}" 2>/dev/null; then
      printf '%s\n' "  umounted ${mount_point}"
      released_mounts=$(( released_mounts + 1 ))
   else
      printf '%s\n' "  FAILED to umount ${mount_point}" >&2
      release_failures=$(( release_failures + 1 ))
   fi
## /proc/mounts, NOT mount(8): mount(8) prints a mount point containing a space
## verbatim, so field-splitting yields a TRUNCATED path -- '/mnt/my nbd' became
## '/mnt/my', which names a different filesystem and would have been unmounted
## instead. /proc/mounts octal-escapes the space (\040), which printf '%b'
## restores unambiguously.
done < <(
   while read -r mounts_device mounts_point _; do
      case "${mounts_device}" in
         /dev/nbd*)
            printf '%b\n' "${mounts_point}"
            ;;
      esac
   done < /proc/mounts
)

released_devices=0
for nbd_device in /dev/nbd[0-9] /dev/nbd[0-9][0-9]; do
   [ -e "${nbd_device}" ] || continue
   ## An unconnected device has size 0, so only touch the ones actually in use.
   size_path="/sys/block/${nbd_device##*/}/size"
   [ -r "${size_path}" ] || continue
   if [ "$( cat -- "${size_path}" )" = "0" ]; then
      continue
   fi
   if [ "${dry_run}" = "true" ]; then
      printf '%s\n' "  would disconnect ${nbd_device}"
      released_devices=$(( released_devices + 1 ))
      continue
   fi
   if sudo --non-interactive qemu-nbd --disconnect "${nbd_device}" >/dev/null 2>&1; then
      printf '%s\n' "  disconnected ${nbd_device}"
      released_devices=$(( released_devices + 1 ))
   else
      printf '%s\n' "  FAILED to disconnect ${nbd_device}" >&2
      release_failures=$(( release_failures + 1 ))
   fi
done

## R-033: pre-compute rather than inlining a substitution in the data string.
summary_suffix=""
if [ "${dry_run}" = "true" ]; then
   summary_suffix=" -- REPORT ONLY, pass --release to act"
fi
printf '%s\n' "${0##*/}: ${released_mounts} mount(s), ${released_devices} device(s)${summary_suffix}"

## A caller that runs this to make nbd usable must be able to tell that it did
## NOT succeed. Printing an error and exiting 0 lets a build proceed straight
## into the unreadable state this exists to clear.
if [ "${release_failures}" -gt 0 ]; then
   printf '%s\n' "${0##*/}: ${release_failures} operation(s) FAILED; nbd is not clean." >&2
   exit 1
fi
